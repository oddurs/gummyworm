# gummyworm configuration file
# ============================================================================
# Copy this file to one of:
#   ~/.gummywormrc              (user defaults)
#   ~/.config/gummyworm/config  (XDG style)
#   ./.gummywormrc              (project specific)
#
# Files are loaded in order; later files override earlier ones.
# CLI arguments always override config file settings.
# ============================================================================

# Output dimensions
# width=80
# height=0                    # 0 = auto-calculate from aspect ratio

# Character palette (built-in name or custom string)
# palette=standard            # Options: standard, detailed, simple, blocks,
#                             #          binary, shades, retro, matrix,
#                             #          emoji, dots, stars, hearts, waves

# Color options
# color=false                 # Enable 256-color output
# truecolor=false             # Enable 24-bit true color output

# Image preprocessing
# brightness=0                # Range: -100 to 100
# contrast=0                  # Range: -100 to 100
# gamma=1.0                   # Range: 0.1 to 10.0

# Display options
# invert=false                # Invert brightness (for dark backgrounds)
# preserve_aspect=true        # Maintain image aspect ratio

# Terminal character cell shape (height:width)
# A character cell is taller than it is wide, so gummyworm divides the row count
# by this to keep proportions true. Set it to match your terminal: if output
# looks too wide/squashed, raise it; too tall/stretched, lower it.
#   1.67  tight line spacing (e.g. iTerm2 at line-height 1.0)
#   2.0   typical, and what HTML/SVG exports render at
#   2.2   loose line spacing
# char_aspect=2.0             # Range: 0.5 to 5.0

# Classic rendering
# One switch for the look before 2.4: enhance=off and color_engine=plain.
# An explicit enhance or color_engine below still wins.
# classic=false               # Options: true, false

# Colour engine
# A character inks only part of its cell, so a colour reaches the eye dimmer
# than it was given. optical picks the character and its colour together to
# make up for that, assuming the background below. plain paints each character
# in the pixel's own colour.
# color_engine=optical        # Options: plain, optical

# Tone enhancement before mapping to characters
# Photos rarely use the full light-to-dark range, so they land on a few
# characters. This spreads the tones out first.
#   off      use the image as it is
#   stretch  spread the tonal range
#   full     stretch, then adaptive local contrast (needs ImageMagick 7.0.8+)
# Turn it off for flat graphics, logos and line art, or when you want the
# image's own contrast kept.
# enhance=full                # Options: off, stretch, full

# Export defaults
# format=text                 # Options: text, ansi, html, svg, png, gif
# background=#1e1e1e          # Background color for html/svg/png exports
# padding=0                   # Padding in pixels for exports

# Animation defaults
# animate=auto                # Options: auto, true, false
# frame_delay=100             # Milliseconds between frames
# max_frames=0                # 0 = no limit
# loops=0                     # 0 = infinite

# Other options
# quiet=false                 # Suppress info messages
